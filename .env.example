# ClearHub 交易核心演示 - 环境变量
# 复制为 .env 后修改；.env 不要提交到版本库。

APP_PORT=8088

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=trade_demo
MYSQL_USER=trade
MYSQL_PASSWORD=change_me_app_password

# 演示行为
DEMO_SEED=true
DEMO_RESET_ENABLED=true
DEMO_MM_ENABLED=true
DEMO_FLOW_ENABLED=true

# 清算所适配器 / 模拟银行
INTEGRATION_ENABLED=true
ADAPTER_TIMEOUT_MS=5000
MOCK_BANK_JAVA_OPTS=-Xms128m -Xmx256m
ADAPTER_JAVA_OPTS=-Xms128m -Xmx256m

# JVM
JAVA_OPTS=-Xms256m -Xmx512m

# 可选工具（docker compose --profile tools up -d）
ADMINER_PORT=8089
